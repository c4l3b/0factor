@inherits RazorLayoutSlice<LayoutModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Title · 0factor</title>
    <style>
        :root {
            color-scheme: light dark;
            --bg: #fff; --fg: #1f2328; --muted: #59636e; --border: #d1d9e0; --surface: #f6f8fa;
            --accent: #2f6290; --accent-fg: #fff; --error: #b42318;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #16191d; --fg: #e3e6ea; --muted: #9aa3ad; --border: #343b44; --surface: #1d2126;
                --accent: #6f9cc6; --accent-fg: #0e1114; --error: #f0857a;
            }
        }
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        main { max-width: 34rem; margin: 0 auto; padding: 3rem 1rem 4rem; }
        h1 { font-size: 1.375rem; font-weight: 600; line-height: 1.3; margin: 0 0 1rem; }
        h2 { font-size: 1rem; font-weight: 600; margin: 2.5rem 0 .75rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
        h3 { font-size: .9375rem; font-weight: 600; margin: 0 0 .75rem; overflow-wrap: anywhere; }
        p { margin: 0 0 1rem; }
        a { color: var(--accent); text-underline-offset: 2px; }
        code { font: .875em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
        label { display: block; margin-bottom: .375rem; font-size: .875rem; font-weight: 500; }
        input:not([type=checkbox]), select, textarea {
            display: block; width: 100%; padding: .5rem .625rem; font: inherit; color: inherit;
            background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
        }
        input[readonly] { background: var(--surface); color: var(--muted); }
        textarea { min-height: 4.5rem; resize: vertical; }
        textarea[name=claims] { font: .875rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
        label:has(> input[type=checkbox]) { display: flex; align-items: center; gap: .5rem; font-weight: 400; }
        input[type=checkbox] { width: 1rem; height: 1rem; margin: 0; accent-color: var(--accent); }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        ::placeholder { color: var(--muted); opacity: .7; }
        .field { margin-bottom: 1.25rem; }
        form > input[type=email] { margin-bottom: 1rem; }
        .help { color: var(--muted); font-size: .8125rem; margin: .375rem 0 0; }
        h2 + .help { margin-bottom: 1rem; }
        .field:has(> .error) :is(input, select, textarea) { border-color: var(--error); }
        fieldset { border: 1px solid var(--border); border-radius: 6px; margin: 0 0 1.25rem; padding: .75rem 1rem 0; }
        legend { padding: 0 .375rem; font-size: .875rem; font-weight: 600; }
        button {
            padding: .5rem 1rem; font: inherit; font-weight: 500; color: inherit; cursor: pointer;
            background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
        }
        button:hover { border-color: var(--muted); }
        /* Primary and destructive buttons are picked by their stable ids so the markup stays untouched. */
        #continue, #register, button[id$="-save"] { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
        #continue:hover, #register:hover, button[id$="-save"]:hover { border-color: var(--accent); filter: brightness(1.08); }
        button[id$="-delete"] { color: var(--error); background: transparent; }
        button[id$="-delete"]:hover { border-color: var(--error); }
        .warn { font-size: .875rem; padding: .5rem .75rem; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 1.5rem; }
        .error { font-weight: 500; color: var(--error); }
        .field .error, fieldset .error, form > .error { margin: .375rem 0 0; font-size: .875rem; }
        .users { list-style: none; padding: 0; margin: 0; }
        .users button { display: block; width: 100%; text-align: left; margin: 0 0 .5rem; padding: .625rem .875rem; font-weight: 400; background: var(--bg); }
        .users button:hover { border-color: var(--accent); background: var(--surface); }
        .users span { display: block; font-size: .875rem; color: var(--muted); overflow-wrap: anywhere; }
        .users .email { font-size: .9375rem; font-weight: 600; color: var(--fg); }
        .users .notes { font-style: italic; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 1rem; font-size: .875rem; }
        th, td { text-align: left; vertical-align: top; padding: .5rem .75rem .5rem 0; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
        th { font-weight: 600; color: var(--muted); }
        .user { padding-top: 1.25rem; margin-bottom: 2rem; border-top: 1px solid var(--border); }
        .user form + form { margin-top: .75rem; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; margin: 0 0 1.25rem; font-size: .875rem; }
        dt { color: var(--muted); }
        dd { margin: 0; overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <main>
        @await RenderBodyAsync()
    </main>
</body>
</html>
