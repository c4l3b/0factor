@inherits RazorSlice<LoginModel>
@implements IUsesLayout<ZeroFactor.Slices._Layout, LayoutModel>

<p class="brand"><span class="logo" aria-hidden="true">0f</span> 0factor <span class="pill">Dev only</span></p>
<div class="card">
<h1 data-testid="login-title">Sign in to @Model.Realm</h1>
<p class="sub" data-testid="banner">Test identity provider. No passwords.</p>

@if (Model.Error is not null)
{
    <p class="error" role="alert" id="error" data-testid="login-error">@Model.Error</p>
}

<form method="post" action="@Model.Action" id="login-form" data-testid="login-form">
    <input type="hidden" name="auth" value="@Model.Auth">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autofocus value="@Model.Email" data-testid="email">
    <button type="submit" id="continue" data-testid="continue">Continue</button>
</form>

<h2 class="or">Or pick a user</h2>
@if (Model.Users.Count == 0 && Model.HiddenCount == 0)
{
    <p data-testid="no-users">No users yet. Type any email to create one.</p>
}
else if (Model.Users.Count > 0)
{
    <form method="post" action="@Model.Action" id="user-list" data-testid="user-list">
        <input type="hidden" name="auth" value="@Model.Auth">
        <ul class="users">
        @foreach (var user in Model.Users)
        {
            var email = user.Email ?? user.Username;
            var name = string.Join(" ", new[] { user.FirstName, user.LastName }.Where(n => !string.IsNullOrEmpty(n)));
            if (name == "")
            {
                foreach (var claim in new[] { "name", "given_name" })
                    if (user.Claims?[claim] is System.Text.Json.Nodes.JsonValue value
                        && value.TryGetValue<string>(out var claimName) && !string.IsNullOrWhiteSpace(claimName))
                    {
                        name = claimName;
                        break;
                    }
            }
            var words = (name != "" ? name : email.Split('@')[0]).Split(' ', '.', '_', '-', '+').Where(w => w != "").ToArray();
            var initials = (words.Length > 1 ? $"{words[0][0]}{words[1][0]}" : words.FirstOrDefault()?[..Math.Min(2, words[0].Length)] ?? "?").ToUpperInvariant();
            var hue = email.Sum(c => c) % 360;
            var roles = string.Join(", ", user.RealmRoles.Concat(user.ClientRoles.SelectMany(c => c.Value.Select(role => $"{c.Key}:{role}"))));
            <li>
                <button type="submit" name="email" value="@email" data-testid="user-@email" class="@(user.Enabled ? null : "disabled")">
                    <span class="avatar" style="--hue: @hue" aria-hidden="true">@initials</span>
                    <span class="who">
                        @if (name != "") { <span data-testid="user-name">@name</span> }
                        <span class="email">Sign in as @email@(user.Pinned ? " (pinned)" : "")@(user.Enabled ? "" : " (disabled)")</span>
                        @if (roles != "") { <span data-testid="user-roles">Roles: @roles</span> }
                        @if (!string.IsNullOrEmpty(user.AgentNotes)) { <span class="notes" data-testid="user-notes">@user.AgentNotes</span> }
                    </span>
                    <span class="chevron" aria-hidden="true">›</span>
                </button>
            </li>
        }
        </ul>
    </form>
}
@if (Model.HiddenCount > 0)
{
    <p class="help" data-testid="hidden-users">@Model.HiddenCount hidden @(Model.HiddenCount == 1 ? "user" : "users"). Type the email above to sign in as one.</p>
}
</div>

@functions {
    public LayoutModel LayoutModel => new($"Sign in to {Model.Realm}");
}
